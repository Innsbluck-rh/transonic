<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.transonic.server</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/local/bin/transonic-server</string>
    <string>serve</string>
    <string>--config</string>
    <string>/Library/Application Support/transonic-server/config.json</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>StandardOutPath</key>
  <string>/var/log/transonic-server.log</string>
  <key>StandardErrorPath</key>
  <string>/var/log/transonic-server.log</string>
</dict>
</plist>
