{
  "name": "transonic",
  "version": "0.1.0",
  "description": "",
  "type": "module",
  "scripts": {
    "start": "vite",
    "predev": "pnpm bindings:export",
    "prebuild": "pnpm format:check && pnpm bindings:check",
    "dev": "tauri dev",
    "build": "tauri build",
    "ad:dev": "tauri android dev",
    "ad:build": "tauri android build",
    "vite:dev": "vite",
    "vite:build": "vite build",
    "cargo:check": "cd src-tauri && cargo check --manifest-path Cargo.toml",
    "cargo:test": "cd src-tauri && cargo test --manifest-path Cargo.toml",
    "test": "vitest run",
    "format": "prettier --write . --config .prettierrc",
    "format:check": "prettier --check . --config .prettierrc",
    "prettier": "pnpm format",
    "lint-staged": "lint-staged",
    "prepare": "simple-git-hooks",
    "setup:media3-flac": "node scripts/setup-media3-flac.mjs",
    "bindings:export": "cargo run --manifest-path src-tauri/Cargo.toml --bin export-bindings",
    "bindings:check": "cargo run --manifest-path src-tauri/Cargo.toml --bin check-bindings"
  },
  "license": "MIT",
  "dependencies": {
    "@atlaskit/pragmatic-drag-and-drop": "^1.8.1",
    "@iconify-icon/solid": "^3.0.3",
    "@solidjs/meta": "^0.29.4",
    "@solidjs/router": "^0.16.1",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-log": "^2.8.0",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-os": "^2.3.2",
    "css-ripple-effect": "^1.0.5",
    "interactjs": "^1.10.27",
    "jsdom": "^29.1.0",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "solid-js": "^1.9.12"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.2.2",
    "@tauri-apps/cli": "^2",
    "@testing-library/jest-dom": "^6.9.1",
    "@types/node": "^25.5.0",
    "@vitest/browser-playwright": "^4.1.2",
    "@vitest/coverage-v8": "^4.1.2",
    "lint-staged": "^16.4.0",
    "playwright": "^1.59.0",
    "prettier": "^3.8.1",
    "prettier-plugin-organize-imports": "^4.3.0",
    "simple-git-hooks": "^2.13.1",
    "tailwindcss": "^4.2.2",
    "typescript": "^6.0.2",
    "vite": "^8.0.3",
    "vite-plugin-solid": "^2.11.11",
    "vite-plugin-webfont-dl": "^3.12.0",
    "vitest": "^4.1.2"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs,cjs,json,css,scss,html,yml,yaml}": "prettier --write --ignore-unknown"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm lint-staged"
  }
}
